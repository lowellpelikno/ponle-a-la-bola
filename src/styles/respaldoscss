.grid-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(50px, 1fr));
  gap: 8px;
  padding: 10px;
  max-height: 500px; /* Ajusta según el tamaño de cada celda */
  overflow-y: auto;
  border: 1px solid #ccc;
  border-radius: 8px;
}

.original-grid{
  height: 200px;
  overflow: scroll;
}

.grid-cell {
  background-color: #3498db;
  color: white;
  padding: 12px;
  border-radius: 6px;
  text-align: center;
  cursor: pointer;
  transition: background-color 0.5s ease;
  font-size: 1.2em;
}

.grid-cell:hover {
  background-color: #2980b9;
}

.grid-cell.clicked {
  background-color: #2ecc71;
}

.cell-number {
  font-weight: bold;
}
.grid-container::-webkit-scrollbar {
  width: 6px;
}

.grid-container::-webkit-scrollbar-thumb {
  background-color: #888;
  border-radius: 4px;
}

.grid-container::-webkit-scrollbar-thumb:hover {
  background-color: #555;
}